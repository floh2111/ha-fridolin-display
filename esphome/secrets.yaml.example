# Im ESPHome Builder (Home Assistant) liegt EINE gemeinsame secrets.yaml
# für alle Geräte. Deshalb haben alle Schlüssel hier das Präfix
# "fridolin_", damit sie nicht mit deinem normalen WLAN (wifi_ssid /
# wifi_password) kollidieren. Diese vier Zeilen einfach in die Secrets
# des Builders (Button oben rechts: "Secrets") dazukopieren.
fridolin_wifi_ssid: "FRIDOLIN_WLAN_NAME"
fridolin_wifi_password: "FRIDOLIN_WLAN_PASSWORT"
# Nur ein Platzhalter, damit ESPHome das Format akzeptiert (ein
# all-zero-Key wird von ESPHome ausdrücklich abgelehnt). Für deine
# echte secrets.yaml einen eigenen, echten Key erzeugen, z.B. mit:
#   openssl rand -base64 32
fridolin_api_key: "1BjiGLxQjRF8fpDFEr637Mxw249ijugjtgOoLwhng6U="
fridolin_ota_password: "HIER_EIN_OTA_PASSWORT_EINTRAGEN"
# Kühlbox direkt per Bluetooth (test-kuehlbox-direkt.yaml). Die Werte holst du aus der
# Home-Assistant-Integration Tuya BLE bzw. dem Tuya-Konto. local_key ist ein Zugangs-
# schlüssel: nie öffentlich posten (der local_key hat genau 16 Zeichen).
fridolin_kuehlbox_mac: "AA:BB:CC:DD:EE:FF"
fridolin_kuehlbox_device_id: "deine_device_id"
fridolin_kuehlbox_uuid: "deine_uuid"
fridolin_kuehlbox_local_key: "example16charkey"
